# HF Sync
# Copiar a ~/.config/hf-sync/.env (o exportar HF_SYNC_CONFIG=/ruta/.env)

HF_TOKEN=
HF_REPO_ID=

ARIA2_RPC_URL=http://localhost:6800/jsonrpc
ARIA2_RPC_SECRET=

RCLONE_REMOTE=
RCLONE_PATH=

LOG_LEVEL=INFO
# DB_PATH y TEMP_DIR tienen defaults XDG (~/.local/share, ~/.cache)
# Descomenta para sobreescribir:
# DB_PATH=data/state.db
# TEMP_DIR=temp
